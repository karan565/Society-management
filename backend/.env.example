NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/society_management?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/society_management?schema=public"
JWT_ACCESS_SECRET=generate-at-least-32-random-bytes
JWT_ACCESS_TTL=15m
JWT_ISSUER=society-management-api
JWT_AUDIENCE=society-management-web
REFRESH_TOKEN_DAYS=30
FRONTEND_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
TRUST_PROXY=0
SUPER_ADMIN_NAME=Society Developer
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-before-seeding

